@echo off
setlocal
set "STREAMLY_BOOTSTRAP=%~f0"
set "STREAMLY_ROOT=%~dp0"
if not exist "%~dp0app\main.py" goto wrongfolder
echo Streamly-Update wird im vorhandenen Projektordner entpackt.
powershell -NoProfile -Command "$ErrorActionPreference='Stop'; $root=$env:STREAMLY_ROOT; $raw=[IO.File]::ReadAllText($env:STREAMLY_BOOTSTRAP); $data=($raw -split '(?m)^:STREAMLY_PAYLOAD\r?\n',2)[1].Trim(); $zip=Join-Path $root 'streamly-update-payload.zip'; [IO.File]::WriteAllBytes($zip,[Convert]::FromBase64String($data)); Expand-Archive -LiteralPath $zip -DestinationPath $root -Force; Remove-Item -LiteralPath $zip"
if errorlevel 1 goto failed
call "%~dp0Streamly_Live_Update\INSTALLIEREN.cmd"
exit /b %errorlevel%
:wrongfolder
echo Bitte diese Datei zuerst in deinen streamnest-Projektordner verschieben.
echo Dort muessen compose.local.yaml und app\main.py vorhanden sein.
pause
exit /b 1
:failed
echo Entpacken fehlgeschlagen. Alternativ das separate ZIP verwenden.
pause
exit /b 1
:STREAMLY_PAYLOAD

